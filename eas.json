{
  "cli": {
    "version": ">= 18.9.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "projectRoot": "mobile",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PROJECT_ROOT": "mobile"
      }
    },
    "preview": {
      "projectRoot": "mobile",
      "distribution": "internal",
      "env": {
        "EXPO_PROJECT_ROOT": "mobile"
      }
    },
    "production": {
      "projectRoot": "mobile",
      "autoIncrement": true,
      "env": {
        "EXPO_PROJECT_ROOT": "mobile"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
